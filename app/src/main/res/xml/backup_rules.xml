<?xml version="1.0" encoding="utf-8"?><!--
   Respaldo para Android 11 o anterior.
   app_prefs no se respalda: guarda si ya se vio el onboarding y la sesión
   (cifrada con una llave del Keystore que no viaja en el respaldo). Así, al
   reinstalar, la app vuelve a empezar con el onboarding.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="app_prefs.xml" />
</full-backup-content>
