<?xml version="1.0" encoding="utf-8"?><!--
   Respaldo para Android 12 o superior.
   app_prefs no se respalda ni se copia a otro teléfono: guarda si ya se vio el
   onboarding y la sesión (cifrada con una llave del Keystore que no viaja).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
